# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New "publishable" key (sb_publishable_...). The legacy anon key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Tashkent

# --- AI feedback (optional, server-only; phase 5) ---
AI_FEEDBACK_ENABLED=false
AI_GATEWAY_API_KEY=
AI_MODEL=

# --- Web Push (phase 6) — generate with: npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The private key lives ONLY in Supabase Edge Function secrets, never here in production.
